    "advantage": "(r - mean_group) / max(std_group, 1e-6), population std",
    "loss": "-mean_tokens(min(rho*A, clip(rho, 1-eps, 1+eps)*A)), rho = exp(lp_train - lp_rollout)",
    "lora_sha256": "sha256 over sorted(name|dtype|shape\\n + raw LE bytes)"
  },
  "files": {
    "steps": "steps.jsonl",
    "rounds": "rounds.csv",
